# Copy to .env and adjust. Every variable uses the EMPORIO_ prefix.
# Only set what differs from the built-in defaults (see src/emporio/config.py).

# Provider: "ollama" (local, free, default) or "openai" (paid API).
EMPORIO_MODEL_PROVIDER=ollama

# Local model served by Ollama. Default is llama3.1:8b; any pulled model works,
# e.g. llama3.2:3b (fast) or qwen2.5:7b (used for the graded sample transcripts).
EMPORIO_OLLAMA_MODEL=llama3.1:8b
# EMPORIO_OLLAMA_HOST=http://localhost:11434

# OpenAI-compatible provider (only read when MODEL_PROVIDER=openai).
# EMPORIO_OPENAI_API_KEY=sk-...
# EMPORIO_OPENAI_MODEL=gpt-4o-mini

# Sampling temperature for both providers. Low default on purpose: a store agent
# should answer the same question the same way. See README (temperature section).
# EMPORIO_TEMPERATURE=0.2
